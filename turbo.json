{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".nvmrc", ".yarnrc.yml"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build:android": {
      "env": ["ANDROID_HOME", "ORG_GRADLE_PROJECT_newArchEnabled"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/android/**",
        "!$TURBO_ROOT$/android/build/**",
        "!$TURBO_ROOT$/android/.gradle/**",
        "$TURBO_ROOT$/src/**"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": [
        "XCODE_VERSION",
        "RCT_NEW_ARCH_ENABLED",
        "RCT_REMOVE_LEGACY_ARCH",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/*.podspec",
        "$TURBO_ROOT$/ios/**",
        "!$TURBO_ROOT$/ios/build/**",
        "$TURBO_ROOT$/src/**"
      ],
      "outputs": []
    }
  }
}
